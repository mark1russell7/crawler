{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "types": ["node"],
    // The tests use the test helpers of polite-crawler (its local sites and stores), so the root is packages/.
    "rootDir": ".."
  },
  "include": ["src/**/*"],
  "exclude": []
}
