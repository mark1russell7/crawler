{
  "$schema": "https://json.schemastore.org/package",
  "name": "polite-crawler",
  "version": "0.2.0",
  "description": "A polite web crawler for research and AI agents. It fetches a source once, keeps it, and reads it many times: robots.txt obeyed, one request per site, full-text search. The MCP server is the package polite-crawler-mcp.",
  "keywords": [
    "crawler",
    "web-crawler",
    "polite-crawler",
    "robots.txt",
    "rfc9309",
    "scraper",
    "web-scraping",
    "fetch",
    "cache",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "research",
    "full-text-search",
    "sqlite",
    "fts5",
    "playwright",
    "headless",
    "json-ld",
    "schema.org",
    "opening-hours",
    "content-signals",
    "aipref"
  ],
  "homepage": "https://mark1russell7.github.io/crawler/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/crawler.git",
    "directory": "packages/polite-crawler"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/crawler/issues"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./robots": "./src/robots.ts",
    "./hours": "./src/hours.ts",
    "./html": "./src/html.ts",
    "./classify": "./src/classify.ts",
    "./politeness": "./src/politeness.ts",
    "./signals": "./src/signals.ts",
    "./record.schema.json": "./record.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "polite-crawler": "./src/cli.ts"
  },
  "files": [
    "build",
    "!build/cli.d.mts",
    "record.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && tsc -p tsconfig.test.json && tsc -p eval/tsconfig.json",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs && pnpm build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "undici": "^8.11.2",
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.0.0 || ^4.0.0",
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@microsoft/api-extractor": "^7.59.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.19.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "5.0.4",
    "fast-check": "^4.10.2",
    "gpt-tokenizer": "^4.0.3",
    "playwright-core": "^1.64.0",
    "tsdown": "^0.23.1",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.mjs",
    "types": "./build/index.d.mts",
    "bin": {
      "polite-crawler": "./build/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "./robots": {
        "types": "./build/robots.d.mts",
        "default": "./build/robots.mjs"
      },
      "./hours": {
        "types": "./build/hours.d.mts",
        "default": "./build/hours.mjs"
      },
      "./html": {
        "types": "./build/html.d.mts",
        "default": "./build/html.mjs"
      },
      "./classify": {
        "types": "./build/classify.d.mts",
        "default": "./build/classify.mjs"
      },
      "./politeness": {
        "types": "./build/politeness.d.mts",
        "default": "./build/politeness.mjs"
      },
      "./signals": {
        "types": "./build/signals.d.mts",
        "default": "./build/signals.mjs"
      },
      "./record.schema.json": "./record.schema.json",
      "./package.json": "./package.json"
    }
  }
}
