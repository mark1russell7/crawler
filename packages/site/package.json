{
  "$schema": "https://json.schemastore.org/package",
  "name": "@crawler/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/eval-latest.ts && astro build",
    "preview": "astro preview",
    "og": "node scripts/og-image.ts",
    "check": "node scripts/check-site.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#01454a6f49e745268264795d4e77e0bb374e96cc",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@mark1russell7/site-pages": "^0.4.1",
    "@mark1russell7/text": "^0.0.5",
    "@pagefind/default-ui": "^1.5.2",
    "astro": "^7.3.8",
    "polite-crawler": "workspace:*",
    "preact": "^11.0.0"
  }
}
