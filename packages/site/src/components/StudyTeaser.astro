---
/**
 * The study in the hero: one square for each of the top 1,000 domains, red where the site refuses
 * GPTBot, and three agents to compare. The build reads the dataset, so the panel needs no script.
 */
import study from "../data/robots-study.json";
import type { Study } from "../lib/study.ts";
import { agentRows, formatDay, niceMax, summarize } from "../lib/study.ts";

const data = study as unknown as Study;
const rows = agentRows(data);
const summary = summarize(data);
const gpt = data.agents.findIndex((agent) => agent.token === "GPTBot");
const cells = data.sites.map((site) => site.p[gpt] ?? ".");
const compare = ["GPTBot", "Claude-User", "Googlebot"].map((token) => rows.find((row) => row.token === token)!);
const max = niceMax(Math.max(...compare.map((row) => row.share)));
const day = formatDay(data.fetched.from);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const width = (sites: number): string => `width:${String((sites / summary.answered / (max / 100)) * 100)}%`;
const keys = [
  { code: "N", text: "refuses GPTBot by name" },
  { code: "S", text: "refuses all bots" },
  { code: "n", text: "names it and permits it" },
  { code: "o", text: "permits it" },
  { code: "B", text: "blocked at the edge" },
  { code: "U", text: "unreachable" },
];
---

<figure class="pc-teaser not-content" aria-labelledby="pc-teaser-title">
  <figcaption>
    <a id="pc-teaser-title" href={`${base}/notes/robots-txt-ai-agents/`}>Who lets AI agents in?</a>
    <span>The crawler read the robots.txt of the top {data.sites.length.toLocaleString("en-US")} domains on {day}. One square is one domain.</span>
  </figcaption>
  <div
    class="pc-teaser-grid"
    role="img"
    aria-label={`${String(compare[0]?.refused)} of the ${String(summary.answered)} sites that answered refuse GPTBot. ${String(summary.blocked)} blocked the request, and ${String(summary.unreachable)} were unreachable.`}
  >
    {cells.map((code) => <i class={code === "." ? "o" : code} />)}
  </div>
  <ul class="pc-teaser-key" aria-hidden="true">
    {
      keys.map((key) => (
        <li>
          <span class={`pc-verdict-key pc-v-${key.code}`} />
          {key.text}
        </li>
      ))
    }
  </ul>
  <dl class="pc-teaser-bars">
    {
      compare.map((row) => (
        <div>
          <dt>
            <code>{row.token}</code>
          </dt>
          <dd>
            <span class="pc-teaser-track" style={`--ticks:${String(max / 5)}`}>
              <span class="pc-v-N" style={width(row.byName)} />
              <span class="pc-v-S" style={width(row.byStar)} />
            </span>
            <span class="pc-teaser-value">{row.share.toFixed(0)}%</span>
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="pc-teaser-note">The shares count the {summary.answered} sites that answered with a file or with no file.</p>
  <a class="pc-teaser-more" href={`${base}/notes/robots-txt-ai-agents/`}>Read the study, with each site and its rules</a>
</figure>
