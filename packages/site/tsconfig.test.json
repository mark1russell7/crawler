{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // astro/client declares the virtual module astro:content of src/content.config.ts
    "types": ["astro/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts", "pure-crawler.ts", "scripts/**/*.ts"],
  "exclude": ["dist", ".astro"]
}
