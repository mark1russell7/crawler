{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The scripts of the repository root (scripts/*.ts). Node.js runs them with type stripping, so only erasable syntax.
  "extends": "@mark1russell7/cue/ts/config/node.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/release/**"]
}
